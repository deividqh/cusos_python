# --- ESTÉTICA GENERAL ---
figure.facecolor: 121212
figure.edgecolor: 121212
figure.figsize: 10, 6
figure.dpi: 100
figure.titlesize: 18
figure.titleweight: bold

# --- EJES ---
axes.facecolor: 1e1e1e
axes.edgecolor: 333333
axes.linewidth: 1.2
axes.grid: True
axes.titlesize: 16
axes.titleweight: bold
axes.labelcolor: e0e0e0
axes.labelsize: 12
axes.axisbelow: True

# --- SPINES ---
axes.spines.top: False
axes.spines.right: False

# --- GRID ---
grid.color: 333333
grid.linestyle: --
grid.alpha: 0.5

# --- CICLO DE COLORES (Sintaxis simplificada sin comillas conflictivas) ---
axes.prop_cycle: cycler(color=['00e5ff', 'ff4081', '76ff03', 'ffea00', 'd500f9', 'ff9100'])

# --- LINEAS Y MARCADORES ---
lines.linewidth: 2.5
lines.markersize: 8
patch.edgecolor: 121212

# --- FUENTES (Sin comillas para que las lea como lista) ---
text.color: e0e0e0
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Helvetica, sans-serif
font.size: 11

# --- TICKS ---
xtick.color: 888888
ytick.color: 888888

# --- LEYENDA ---
legend.facecolor: 1e1e1e
legend.edgecolor: 333333
legend.fontsize: 10

# --- GUARDADO ---
savefig.facecolor: 121212
savefig.bbox: tight